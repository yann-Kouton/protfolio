# Copie ce fichier en ".env" en local, et ajoute les mêmes valeurs
# dans Vercel > Project Settings > Environment Variables.

# --- Firebase (console.firebase.google.com > Paramètres du projet > Général > Vos applications) ---
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=ton-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ton-projet
VITE_FIREBASE_STORAGE_BUCKET=ton-projet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:xxxxxx

# --- Cloudinary (cloudinary.com > Dashboard) ---
VITE_CLOUDINARY_CLOUD_NAME=ton-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=ton-upload-preset-non-signe
